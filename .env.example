# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Replace this placeholder. Never put the real token in browser code or static hosting.
API_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
# Exact browser origins, comma-separated; empty disables cross-origin access.
CORS_ORIGINS=http://localhost:8000
PORT=3001
